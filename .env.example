# Bloom & Blush Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Example)
DATABASE_URL=mongodb://localhost:27017/bloomblush
# DATABASE_URL=postgresql://user:pass@localhost:5432/bloomblush

# Payment Gateway (e.g. Stripe)
STRIPE_SECRET_KEY=sk_test_1234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdef

# Email Service (e.g. SendGrid / SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.bloomandblush.com
SMTP_PASS=your_smtp_password
SENDGRID_API_KEY=sg_example_key

# Admin Authentication Secret (JWT)
JWT_SECRET=super_secret_jwt_string

# ============================================
# TWILIO WHATSAPP INTEGRATION
# ============================================

# Your Twilio Account SID (Found on Twilio console dashboard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token (Keep this secret!)
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio Sandbox number for WhatsApp (e.g. +14155238886)
TWILIO_WHATSAPP_SANDBOX=+14155238886

# Admin Phone Number (Must be in E.164 format, e.g. +919876543210)
TWILIO_PHONE=+91xxxxxxxxxx
